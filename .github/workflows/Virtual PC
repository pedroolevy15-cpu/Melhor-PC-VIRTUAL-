  document.querySelector(
    "#startSearch"
  ).focus();

};

document.querySelector(
  "#startSearch"
).addEventListener(
  "input",
  event => {

    const query =
      event.target.value
        .toLowerCase();

    document
      .querySelectorAll(
        ".start-grid button"
      )
      .forEach(button => {

        button.style.display =
          button.textContent
            .toLowerCase()
            .includes(query)
              ? ""
              : "none";

      });

  }
);

function updateClock() {

  document.querySelector(
    "#clock"
  ).textContent =
    new Intl.DateTimeFormat(
      "pt-BR",
      {
        hour: "2-digit",
        minute: "2-digit"
      }
    ).format(
      new Date()
    );

}

updateClock();

