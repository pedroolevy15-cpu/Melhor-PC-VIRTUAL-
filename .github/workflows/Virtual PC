function openApp(id) {

  if (!apps[id]) return;

  if (state.windows.has(id)) {

    focusWindow(id);

    return;
  }

  const currentApp = apps[id];

  const windowElement =
    document.createElement("article");

  windowElement.className = "window";

  windowElement.dataset.id = id;

  windowElement.style.zIndex = ++state.z;

  const offset =
    50 + state.windows.size * 24;

  windowElement.style.left =
    `${Math.min(offset, innerWidth - 430)}px`;

  windowElement.style.top =
    `${Math.min(offset, innerHeight - 330)}px`;

  windowElement.innerHTML = `

    <header class="titlebar">

      <span>
        ${currentApp.icon}
        ${currentApp.title}
      </span>

      <div>

        <button class="min">
          —
        </button>

        <button class="max">
          □
        </button>

        <button class="close">
          ×
        </button>

      </div>

    </header>

    <div class="window-content">
      ${currentApp.html}
    </div>

  `;

  windowsEl.appendChild(windowElement);

  state.windows.set(
    id,
    windowElement
  );

  addTaskButton(
    id,
    currentApp
  );

  focusWindow(id);

  makeDraggable(
    windowElement
  );

  wireApp(
    id,
    windowElement
  );
}

function wireApp(id, element) {

  if (id === "notes") {

    const area =
      element.querySelector("#notesArea");

    area.value = state.notes;

    area.addEventListener(
      "input",
      () => {

        state.notes =
          area.value;

        localStorage.setItem(
          "vw-notes",
          state.notes
        );

      }
    );
  }

  if (id === "settings") {

    const toggle =
      element.querySelector("#darkToggle");

    toggle.checked =
      state.theme === "dark";

    toggle.addEventListener(
      "change",
      event => {

        state.theme =
          event.target.checked
            ? "dark"
            : "light";

        localStorage.setItem(
          "vw-theme",
          state.theme
        );

        desktop.classList.toggle(
          "dark",
          event.target.checked
        );

      }
    );
  }

  if (id === "calculator") {

    setupCalculator(
      element
    );
  }

  element.querySelector(
    ".close"
  ).onclick = () => {

    closeApp(id);

  };

  element.querySelector(
    ".min"
  ).onclick = () => {

    element.classList.toggle(
      "hidden-window"
    );

  };

  element.querySelector(
    ".max"
  ).onclick = () => {

    element.classList.toggle(
      "maximized"
    );

  };
}

function setupCalculator(element) {

  const display =
    element.querySelector(
      "#calcDisplay"
    );

  let expression = "";

  element
    .querySelectorAll("[data-calc]")
    .forEach(button => {

      button.onclick = () => {

        const value =
          button.dataset.calc;

        if (value === "C") {

          expression = "";

        } else if (value === "=") {

          try {

            if (
              !/^[0-9+*/.() -]+$/
                .test(expression)
            ) {

              throw new Error();

            }

            expression =
              String(
                Function(
                  `"use strict";return (${expression})`
                )()
              );

          } catch {

            expression = "Erro";

          }

        } else {

          if (
            expression === "Erro"
          ) {

            expression = "";

          }

          expression += value;

        }

        display.value =
          expression || "0";

      };

    });
}

function addTaskButton(id, currentApp) {

  const button =
    document.createElement("button");

  button.className =
    "task-app";

  button.dataset.id =
    id;

  button.textContent =
    `${currentApp.icon} ${currentApp.title}`;

  button.onclick = () => {

    const windowElement =
      state.windows.get(id);

    if (
      windowElement.classList.contains(
        "hidden-window"
      )
    ) {

      windowElement.classList.remove(
        "hidden-window"
      );

      focusWindow(id);

    } else {

      focusWindow(id);

    }

  };

  taskApps.appendChild(
    button
  );
}

function closeApp(id) {

  const windowElement =
    state.windows.get(id);

  if (windowElement) {

    windowElement.remove();

  }

  state.windows.delete(id);

  const task =
    taskApps.querySelector(
      `[data-id="${id}"]`
    );

  if (task) {

    task.remove();

  }
}

function focusWindow(id) {

  const windowElement =
    state.windows.get(id);

  if (!windowElement) return;

  windowElement.classList.remove(
    "hidden-window"
  );

  windowElement.style.zIndex =
    ++state.z;

  taskApps
    .querySelectorAll(".task-app")
    .forEach(button => {

      button.classList.toggle(
        "active",
        button.dataset.id === id
      );

    });
}

function makeDraggable(element) {

  const bar =
    element.querySelector(
      ".titlebar"
    );

  let dragging = false;

  let startX = 0;
  let startY = 0;

  let originalX = 0;
  let originalY = 0;

  bar.addEventListener(
    "pointerdown",
    event => {

      if (
        event.target.closest("button") ||
        element.classList.contains(
          "maximized"
        )
      ) {

        return;

      }

      dragging = true;

      bar.setPointerCapture(
        event.pointerId
      );

      startX =
        event.clientX;

      startY =
        event.clientY;

      originalX =
        element.offsetLeft;

      originalY =
        element.offsetTop;

      focusWindow(
        element.dataset.id
      );

    }
  );

  bar.addEventListener(
    "pointermove",
    event => {

      if (!dragging) return;

      element.style.left =
        `${Math.max(
          0,
          originalX +
          event.clientX -
          startX
        )}px`;

      element.style.top =
        `${Math.max(
          0,
          originalY +
          event.clientY -
          startY
        )}px`;

    }
  );

  bar.addEventListener(
    "pointerup",
    () => {

      dragging = false;

    }
  );
}

document.addEventListener(
  "click",
  event => {

    const opener =
      event.target.closest(
        "[data-open]"
      );

    if (!opener) return;

    openApp(
      opener.dataset.open
    );

    startMenu.classList.remove(
      "open"
    );

  }
);

